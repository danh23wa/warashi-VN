 source /Users/danh/Desktop/warashi/.venv/bin/activate
{
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=Asia/Ho_Chi_Minh"]
    },
    "ddg-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"]
    },
    "warashi-files": {
      "command": "uv",
      "args": ["run", "python", "scripts/mcp_file_server.py"],
      "cwd": "."
    }
  }
}
